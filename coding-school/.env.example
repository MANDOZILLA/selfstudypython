# Optional: enable the OpenRouter-backed tutor.
# Without a key, the built-in deterministic tutor answers instead and the app
# works fully offline. Never commit a real key to version control.
OPENROUTER_API_KEY=

# Any OpenRouter model slug (see https://openrouter.ai/models).
# Default verified against the OpenRouter catalog: cheap and supports
# structured JSON responses.
TUTOR_MODEL=openai/gpt-4o-mini

# Optional overrides for the tutor provider call.
# TUTOR_TIMEOUT_MS=20000
# TUTOR_MAX_RESPONSE_BYTES=65536
